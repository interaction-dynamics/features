{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "sortImports": { "newlinesBetween": false },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "coverage",
    "playwright-report",
    "test-results",
    "public/features.json",
    "public/metadata.json",
    "src/components/ui"
  ]
}
