{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/no-array-index-key": "warn",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/preserve-manual-memoization": "warn"
  },
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    "src/components/ui"
  ]
}
