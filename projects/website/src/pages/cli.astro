---
import { Code } from 'astro:components'
import {
  ChevronDown,
  FileLock,
  FileSearch,
  GitCompare,
  Hammer,
  LayoutDashboard,
  ListTree,
  ShieldCheck,
  Users,
} from '@lucide/astro'
import CallToAction from '../components/CallToAction.astro'
import PageHero from '../components/PageHero.astro'
import Section from '../components/Section.astro'
import Terminal from '../components/Terminal.astro'
import { site } from '../data/site'
import Base from '../layouts/Base.astro'

const description =
  'Install features-cli with npx, npm, Homebrew or cargo. Scan features, serve the dashboard, build a static site, generate CODEOWNERS and list the features touched by a pull request.'

const install = [
  {
    id: 'npx',
    label: 'npx',
    hint: 'Run without installing',
    command: 'npx features-cli@latest serve ./src',
  },
  {
    id: 'npm',
    label: 'npm',
    hint: 'Install globally from npm',
    command: 'npm install -g features-cli',
  },
  {
    id: 'brew',
    label: 'Homebrew',
    hint: 'Install on macOS or Linux',
    command: 'brew install interaction-dynamics/tap/features',
  },
  {
    id: 'cargo',
    label: 'cargo',
    hint: 'Install the prebuilt binary from crates.io',
    command: 'cargo binstall features-cli',
  },
]

const commands = [
  {
    icon: ListTree,
    name: 'scan',
    usage: 'features scan [PATH]',
    text: 'List the features. The default action, so features PATH works too.',
  },
  {
    icon: LayoutDashboard,
    name: 'serve',
    usage: 'features serve [PATH]',
    text: 'Start an HTTP server with the web dashboard, refreshed when files change.',
  },
  {
    icon: Hammer,
    name: 'build',
    usage: 'features build [PATH]',
    text: 'Build a static version of the web dashboard to host anywhere.',
  },
  {
    icon: FileLock,
    name: 'codeowners',
    usage: 'features codeowners [PATH]',
    text: 'Generate or update a CODEOWNERS file from feature ownership.',
  },
  {
    icon: FileSearch,
    name: 'find-owner',
    usage: 'features find-owner <TARGET> [PATH]',
    text: 'Find the owner of a specific file or folder.',
  },
  {
    icon: Users,
    name: 'owners',
    usage: 'features owners [PATH]',
    text: 'Display only the unique list of owners.',
  },
  {
    icon: ShieldCheck,
    name: 'check',
    usage: 'features check [PATH]',
    text: 'Run validation checks on features, such as duplicate names.',
  },
  {
    icon: GitCompare,
    name: 'diff',
    usage: 'features diff [PATH] --since <ref>',
    text: 'List the features touched since a git ref, with their owners.',
  },
]

const commandNames = commands.map((command) => command.name)

type Option = [flag: string, commands: string, text: string]

const optionGroups: { title: string; options: Option[] }[] = [
  {
    title: 'Output',
    options: [
      ['--json', 'scan, find-owner, owners, diff', 'Output as JSON'],
      [
        '--flat',
        'scan',
        'Output features as a flat array instead of a nested structure',
      ],
      ['--description', 'scan', 'Include feature descriptions'],
      [
        '--coverage',
        'scan',
        'Include coverage (always on with --json, serve and build)',
      ],
      [
        '--strip-emails',
        'all',
        'Remove commit author emails before publishing a build; names are kept',
      ],
    ],
  },
  {
    title: 'Dashboard',
    options: [
      ['--port <port>', 'serve', 'Change the port (default: 3000)'],
      [
        '--allow-origin <origin>',
        'serve',
        'Allow another origin to read the data via CORS. Repeatable; by default only localhost is answered',
      ],
      [
        '--build-dir <path>',
        'build',
        'Output directory for the static build (default: build)',
      ],
    ],
  },
  {
    title: 'Diff',
    options: [
      [
        '--since <ref>',
        'diff',
        'Compare with the merge base of <ref> and HEAD, uncommitted changes included',
      ],
      ['--committed-only', 'diff', 'Ignore uncommitted and untracked files'],
      [
        '--markdown',
        'diff',
        'Output a markdown table for pull request comments',
      ],
      ['--owners-only', 'diff', 'Print only the unique owners, one per line'],
    ],
  },
  {
    title: 'CODEOWNERS',
    options: [
      [
        '--generate-codeowners',
        'serve, build, check',
        'Also generate or update the CODEOWNERS file',
      ],
      [
        '--codeowners-path <path>',
        'codeowners',
        'Custom path and filename (default: CODEOWNERS)',
      ],
      [
        '--codeowners-prefix <prefix>',
        'codeowners, diff',
        'Prefix for owner names (default: @)',
      ],
    ],
  },
  {
    title: 'Scanning',
    options: [
      [
        '--project-dir <path>',
        'all',
        'Project directory for CODEOWNERS paths and extra coverage locations',
      ],
      [
        '--skip-changes',
        'all',
        'Skip computing git history (faster for large repos)',
      ],
      [
        '--ignore-path <path>',
        'all',
        'Ignore a folder and its subfolders. Repeatable',
      ],
      [
        '--include-skipped-dirs',
        'all',
        'Also scan folders skipped by default (node_modules)',
      ],
      [
        '--coverage-dir <path>',
        'all',
        'Custom coverage directory (overrides automatic search)',
      ],
    ],
  },
]

/** Commands accepting an option, as a space-separated list for filtering. */
const acceptedBy = (list: string) =>
  list === 'all' ? commandNames.join(' ') : list.split(/,\s*/).join(' ')

const optionTabs = ['all', ...commandNames]

const workflow = `name: Features touched
on: pull_request

permissions:
  contents: read
  pull-requests: write

jobs:
  features:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
        with:
          fetch-depth: 0 # the merge base with the target branch is needed

      - name: List touched features
        run: npx features-cli@latest diff src --since origin/\${{ github.base_ref }} --committed-only --markdown > features.md

      - name: Comment on the pull request
        env:
          GH_TOKEN: \${{ github.token }}
        run: gh pr comment \${{ github.event.pull_request.number }} --body-file features.md --edit-last --create-if-none`

const reviewers = `features diff src --since origin/master --committed-only --owners-only --codeowners-prefix my-org/ \\
  | xargs -r -n1 gh pr edit "$PR_NUMBER" --add-reviewer`

const codeowners = `# ==== GENERATED BY FEATURES-CLI ====
/src/features/feature-1 @team1
/src/features/feature-2 @team2
# ==== END SECTION GENERATED BY FEATURES-CLI ====`
---

<Base
  title="CLI reference"
  description={description}
  breadcrumbs={[{ name: 'CLI', path: '/cli' }]}
>
  <PageHero
    eyebrow="features-cli"
    title="One binary for every feature report"
    lead="A fast CLI written in Rust, distributed on npm and crates.io. Each action is a command, and PATH defaults to the current directory."
  >
    <div class="card mx-auto mt-10 max-w-2xl p-4 text-left" data-install>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3" data-install-picker>
        <label for="install-tool" class="text-xs text-muted">Install with</label>
        <div class="relative">
          <select
            id="install-tool"
            class="w-full cursor-pointer appearance-none rounded-lg border border-line bg-surface-2 py-2 pr-9 pl-3 text-sm font-medium text-text transition hover:border-cyan/60 sm:w-48"
            data-install-select
          >
            {install.map((item) => <option value={item.id}>{item.label}</option>)}
          </select>
          <ChevronDown
            size={16}
            class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-muted"
            aria-hidden="true"
          />
        </div>
        <p class="text-xs text-muted sm:ml-auto" aria-live="polite" data-install-hint>{install[0].hint}</p>
      </div>
      {
        install.map((item, index) => (
          <div class="mt-3" data-install-panel={item.id} data-hint={item.hint} hidden={index !== 0}>
            <code class="block overflow-x-auto !px-3 !py-2 !text-sm whitespace-nowrap">
              <span class="select-none text-muted">$ </span>{item.command}
            </code>
          </div>
        ))
      }
      <noscript>
        <style is:inline>
          [data-install] [data-install-panel] { display: block !important; }
          [data-install-picker] { display: none !important; }
        </style>
      </noscript>
    </div>
  </PageHero>

  <Section id="commands" eyebrow="Commands" title="Eight commands, one per question">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        commands.map(({ icon: Icon, name, usage, text }) => (
          <li class="card flex flex-col p-5">
            <div class="flex items-center gap-2">
              <Icon size={18} class="text-cyan" aria-hidden="true" />
              <h3 class="font-mono font-semibold">{name}</h3>
            </div>
            <p class="mt-2 flex-1 text-sm text-muted">{text}</p>
            <code class="mt-4 block overflow-x-auto !text-[0.7rem] whitespace-nowrap">{usage}</code>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-muted">
      Run <code>features &lt;command&gt; --help</code> for the options of a command.
    </p>
  </Section>

  <Section
    id="options"
    eyebrow="Options"
    title="Options at a glance"
    lead="Grouped by what they change. Pick a command to see only the options it accepts."
  >
    <div data-option-tabs>
      <div
        role="tablist"
        aria-label="Filter options by command"
        class="mb-6 flex gap-1 overflow-x-auto rounded-xl border border-line bg-surface/70 p-1"
      >
        {
          optionTabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`options-tab-${tab}`}
              aria-controls="options-panel"
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-tab={tab}
              class="shrink-0 rounded-lg px-3 py-1.5 font-mono text-xs text-muted transition hover:text-text aria-selected:bg-surface-2 aria-selected:text-text aria-selected:shadow-[inset_0_-2px_0_var(--color-cyan)]"
            >
              {tab === 'all' ? 'All commands' : tab}
            </button>
          ))
        }
      </div>
      <div id="options-panel" role="tabpanel" aria-labelledby="options-tab-all" class="grid gap-6">
        {
          optionGroups.map((group) => (
            <div class="card overflow-hidden" data-option-group>
              <h3 class="border-b border-line bg-surface-2 px-5 py-3 text-sm font-semibold">{group.title}</h3>
              <dl class="divide-y divide-line/60">
                {group.options.map(([flag, commandsList, text]) => (
                  <div
                    class="grid gap-1 px-5 py-3 sm:grid-cols-[minmax(0,13rem)_1fr] sm:gap-4"
                    data-commands={acceptedBy(commandsList)}
                  >
                    <dt>
                      <code class="!text-xs">{flag}</code>
                      <span class="mt-1 block text-[0.7rem] text-muted">{commandsList}</span>
                    </dt>
                    <dd class="text-sm text-muted">{text}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </div>
    <p class="mt-6 text-sm text-muted">
      <strong class="text-text">Legacy flags.</strong> Actions used to be flags (<code>--serve</code>, <code>--build</code>,
      <code>--check</code>, <code>--list-owners</code>, <code>--find-owner</code>). They still work but are deprecated.
    </p>
  </Section>

  <Section
    id="pull-requests"
    eyebrow="Features touched by a change"
    title="Comment on pull requests with GitHub Actions"
    lead="features diff compares the merge base of a ref and HEAD with your working tree. Each changed file is mapped to its closest feature; a renamed file touches both its old and new feature. The command exits with 0 even when nothing is touched."
  >
    <div class="grid items-start gap-6 lg:grid-cols-[1.3fr_1fr]">
      <figure>
        <figcaption class="mb-2 font-mono text-xs text-muted">.github/workflows/features.yml</figcaption>
        <Code code={workflow} lang="yaml" theme="github-dark-default" />
      </figure>
      <div class="space-y-4">
        <div class="card p-5">
          <h3 class="font-semibold">Three output formats</h3>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            <li><code>--json</code> — features with owner, <code>is_owner_inherited</code> and changed files, plus files outside features.</li>
            <li><code>--markdown</code> — a table ready to post as a comment.</li>
            <li><code>--owners-only</code> — unique owners, one per line.</li>
          </ul>
        </div>
        <div class="card p-5">
          <h3 class="font-semibold">Request reviews from owners</h3>
          <p class="mt-2 text-sm text-muted">Reviewers must be GitHub users or <code>org/team</code> slugs, so set the prefix accordingly.</p>
          <div class="mt-3"><Code code={reviewers} lang="bash" theme="github-dark-default" wrap /></div>
        </div>
        <p class="text-xs text-muted">
          Pull requests from forks get a read-only token: commenting from those needs a <code>pull_request_target</code>
          workflow. Read GitHub's security guidance before using it.
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="codeowners"
    eyebrow="Ownership"
    title="CODEOWNERS that stay in sync"
    lead="Ownership declared in feature READMEs is written to a managed section of CODEOWNERS. Anything outside the markers is preserved on each run."
  >
    <div class="grid items-start gap-6 lg:grid-cols-2">
      <Terminal title="generate CODEOWNERS">
<span class="text-muted"># in the current directory</span>
<span class="select-none text-muted">$ </span>features codeowners ./src

<span class="text-muted"># with paths relative to the project root</span>
<span class="select-none text-muted">$ </span>features codeowners ./src --project-dir ./

<span class="text-muted"># combined with serve, build or check</span>
<span class="select-none text-muted">$ </span>features build ./src --generate-codeowners --project-dir ./</Terminal>
      <figure>
        <figcaption class="mb-2 font-mono text-xs text-muted">CODEOWNERS</figcaption>
        <Code code={codeowners} lang="text" theme="github-dark-default" />
      </figure>
    </div>
  </Section>

  <Section
    id="coverage"
    eyebrow="Test coverage"
    title="Coverage reports, mapped to features"
    lead="Run your tests with coverage enabled (for example npx jest --coverage). LCOV and Cobertura reports are found automatically in coverage or .coverage folders."
  >
    <ol class="grid gap-4 md:grid-cols-4">
      <li class="card p-5"><p class="font-mono text-xs text-muted">1</p><p class="mt-1 text-sm"><code>PATH/coverage</code></p><p class="mt-1 text-xs text-muted">the scanned folder</p></li>
      <li class="card p-5"><p class="font-mono text-xs text-muted">2</p><p class="mt-1 text-sm"><code>./coverage</code></p><p class="mt-1 text-xs text-muted">where the CLI runs</p></li>
      <li class="card p-5"><p class="font-mono text-xs text-muted">3</p><p class="mt-1 text-sm"><code>project-dir/coverage</code></p><p class="mt-1 text-xs text-muted">with <code>--project-dir</code></p></li>
      <li class="card border-cyan/40 p-5"><p class="font-mono text-xs text-cyan">override</p><p class="mt-1 text-sm"><code>--coverage-dir</code></p><p class="mt-1 text-xs text-muted">any custom location</p></li>
    </ol>
    <p class="mt-8 text-sm text-muted">
      Full reference in the <a class="link" href={`${site.repository}#readme`} rel="noopener">README on GitHub</a>.
    </p>
  </Section>

  <CallToAction />
</Base>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const select = root.querySelector<HTMLSelectElement>('[data-install-select]')
    const hint = root.querySelector<HTMLElement>('[data-install-hint]')
    const panels = root.querySelectorAll<HTMLElement>('[data-install-panel]')
    const show = (id: string) => {
      for (const panel of panels) {
        const active = panel.dataset.installPanel === id
        panel.hidden = !active
        if (active && hint) hint.textContent = panel.dataset.hint ?? ''
      }
    }
    select?.addEventListener('change', () => show(select.value))
    if (select) show(select.value)
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-option-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]')
    const rows = root.querySelectorAll<HTMLElement>('[data-commands]')
    const groups = root.querySelectorAll<HTMLElement>('[data-option-group]')

    const select = (tab: HTMLButtonElement, focus = false) => {
      const command = tab.dataset.tab ?? 'all'
      for (const other of tabs) {
        const active = other === tab
        other.setAttribute('aria-selected', String(active))
        other.tabIndex = active ? 0 : -1
      }
      panel?.setAttribute('aria-labelledby', tab.id)
      for (const row of rows) {
        row.hidden = command !== 'all' && !row.dataset.commands?.split(' ').includes(command)
      }
      for (const group of groups) {
        group.hidden = !group.querySelector('[data-commands]:not([hidden])')
      }
      if (focus) tab.focus()
    }

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => select(tab))
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1
        const next =
          event.key === 'ArrowRight' ? (index === last ? 0 : index + 1)
          : event.key === 'ArrowLeft' ? (index === 0 ? last : index - 1)
          : event.key === 'Home' ? 0
          : event.key === 'End' ? last
          : -1
        if (next === -1) return
        event.preventDefault()
        select(tabs[next], true)
      })
    }
  }
</script>
