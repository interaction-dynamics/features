---
import {
  ArrowRight,
  BookOpen,
  Brain,
  Braces,
  ChartPie,
  Construction,
  FileLock,
  Flag,
  FlaskConical,
  FolderTree,
  GitCommitHorizontal,
  GitPullRequest,
  Layers,
  LayoutDashboard,
  ScanEye,
  Sparkles,
  Users,
} from '@lucide/astro'
import CallToAction from '../components/CallToAction.astro'
import Screenshot from '../components/Screenshot.astro'
import Section from '../components/Section.astro'
import Terminal from '../components/Terminal.astro'
import { site } from '../data/site'
import Base from '../layouts/Base.astro'

const aiEraReasons = [
  {
    icon: Sparkles,
    title: "Lines of code don't mean much",
    text: 'An agent writes a thousand lines as easily as ten. What matters is what the code does for your users: the features.',
  },
  {
    icon: Layers,
    title: 'Features pile up fast',
    text: 'When people and agents ship every day, nobody holds the whole product in their head. Features get duplicated, forgotten or left half-finished.',
  },
  {
    icon: ScanEye,
    title: 'Reviews get shallower',
    text: 'The more code is generated, the less of it is read closely. A higher-level view shows where each change lands and whose feature it touches.',
  },
  {
    icon: Brain,
    title: 'The reasoning gets lost',
    text: "An agent's reasoning vanishes with its session. Docs and decision records kept next to each feature keep it for the next person, or the next agent.",
  },
]

const capabilities = [
  {
    icon: FolderTree,
    title: 'List every feature',
    text: 'Scan any folder and get the full tree of features, nested features included.',
  },
  {
    icon: Users,
    title: 'Find the owner',
    text: 'Know which team owns a feature, a folder or a single file in one command.',
  },
  {
    icon: GitCommitHorizontal,
    title: 'Read the history',
    text: 'Get the git log of each feature, split into feature, fix and refactor commits.',
  },
  {
    icon: BookOpen,
    title: 'Surface the docs',
    text: 'README descriptions and decision records (ADR) are attached to their feature.',
  },
  {
    icon: FlaskConical,
    title: 'Coverage by feature',
    text: 'LCOV and Cobertura reports are mapped back to each feature automatically.',
  },
  {
    icon: Construction,
    title: 'Track technical debt',
    text: 'TODOs found in the code are counted per feature so debt stays visible.',
  },
  {
    icon: ChartPie,
    title: 'Measure everything',
    text: 'Lines of code, files and the repartition of commit types for every feature.',
  },
  {
    icon: FileLock,
    title: 'Generate CODEOWNERS',
    text: 'Turn feature ownership into a CODEOWNERS file, kept in sync on each run.',
  },
  {
    icon: GitPullRequest,
    title: 'Ping the right teams',
    text: 'List the features and owners touched by a change, right in your pull request.',
  },
  {
    icon: Flag,
    title: 'Map feature flags',
    text: 'Annotate code with comments to track flags, experiments and dependencies.',
  },
]

const languages = [
  'Rust',
  'TypeScript',
  'JavaScript',
  'Python',
  'Go',
  'Java',
  'Kotlin',
  'Swift',
  'C#',
  'C/C++',
  'Scala',
  'Ruby',
  'Perl',
  'Lua',
  'SQL',
  'Bash',
  'CSS/SCSS',
  'YAML',
  'TOML',
  'HTML/XML',
]

const dashboardFeatures = [
  {
    name: 'auth',
    owner: 'team-auth',
    coverage: 92,
    todos: 1,
    mix: [55, 25, 20],
  },
  {
    name: 'billing',
    owner: 'team-billing',
    coverage: 74,
    todos: 4,
    mix: [40, 45, 15],
  },
  {
    name: 'search',
    owner: 'team-discovery',
    coverage: 61,
    todos: 7,
    mix: [35, 30, 35],
  },
  {
    name: 'onboarding',
    owner: 'team-growth',
    coverage: 88,
    todos: 0,
    mix: [70, 15, 15],
  },
]

// Deterministic scatter of commits per week for the background chart of the hero.
const weeks = ['Aug', 'Sep', 'Oct', 'Nov']
const commitDots = weeks.flatMap((_, week) => {
  let seed = week * 7919 + 17
  const random = () => {
    seed = (seed * 16807) % 2147483647
    return seed / 2147483647
  }
  const center = 70 - week * 9
  return Array.from({ length: 34 }, () => ({
    x: 46 + week * 78 + (random() - 0.5) * 18,
    y: center + (random() + random() + random() - 1.5) * 26,
    r: 1.6 + random() * 0.8,
    level: random(),
  }))
})

const ring = (coverage: number) => {
  const circumference = 2 * Math.PI * 6
  return `${(coverage / 100) * circumference} ${circumference}`
}

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'features-cli',
  alternateName: site.name,
  description: site.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  license: 'https://opensource.org/licenses/MIT',
  url: site.repository,
  downloadUrl: site.npm,
  installUrl: site.npm,
  softwareHelp: { '@type': 'CreativeWork', url: site.demo },
  sameAs: [site.repository, site.npm, site.crate],
  isAccessibleForFree: true,
  keywords:
    'feature-based architecture, codebase map, code ownership, CODEOWNERS, technical debt, test coverage, architecture decision records, AI coding agents',
  featureList: capabilities.map((capability) => capability.title),
  screenshot: new URL('/screenshots/insights@2x.webp', Astro.site ?? Astro.url).href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: {
    '@type': 'Organization',
    '@id': `${site.organizationUrl}/#organization`,
    name: site.organization,
    url: site.organizationUrl,
  },
}
---

<Base
  title={site.name}
  description={site.description}
  jsonLd={[softwareApplication]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 pt-16 pb-20 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:pt-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1 text-xs text-muted">
          <span class="size-1.5 rounded-full bg-accent-3" aria-hidden="true"></span>
          Open source · Any language
        </p>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-balance sm:text-6xl">
          Every feature of your codebase, <span class="text-gradient">mapped.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-pretty text-muted">
          <strong class="font-semibold text-text">Features</strong> is a CLI and web dashboard that finds the
          features in your project, shows who owns them, and measures their history, coverage and technical debt.
          It works with any programming language or framework.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/feature-based-architecture" class="bg-gradient-brand inline-flex items-center gap-2 rounded-lg px-5 py-2.5 font-semibold text-ink transition hover:brightness-110">
            Discover the concept <ArrowRight size={18} aria-hidden="true" />
          </a>
          <a href={site.demo} class="rounded-lg border border-line px-5 py-2.5 font-semibold transition hover:border-muted">
            Live demo
          </a>
        </div>
        <code class="mt-8 block w-fit max-w-full overflow-x-auto rounded-lg !bg-surface px-4 py-2.5 !text-sm whitespace-nowrap">
          <span class="text-muted select-none">$ </span>npx features-cli@latest serve ./src
        </code>
      </div>

      <!-- Dashboard illustration: two layered panels, Linear-style -->
      <div class="relative sm:pt-32" role="img" aria-label="Illustration of the Features dashboard: a list of features with their owner, coverage and commit mix, over a chart of commits per week">
        <div class="spotlight pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

        <!-- Back panel: commits per week -->
        <div class="card fade-b absolute top-0 right-0 hidden w-[74%] p-4 opacity-80 shadow-2xl shadow-black/60 sm:block" aria-hidden="true">
          <div class="flex items-center justify-between text-[0.7rem] text-muted">
            <span>Commits per week</span>
            <span class="font-mono">by feature</span>
          </div>
          <svg viewBox="0 0 300 150" class="mt-2 w-full" fill="none">
            {[40, 75, 110].map((y) => <line x1="20" x2="300" y1={y} y2={y} stroke="var(--color-line)" stroke-dasharray="2 4" />)}
            <path d="M20 66 C 70 66, 80 58, 124 58 S 180 50, 202 50 S 260 40, 300 38" stroke="var(--color-accent-3)" stroke-opacity="0.6" />
            <path d="M20 96 C 70 96, 80 88, 124 86 S 180 84, 202 80 S 260 70, 300 72" stroke="var(--color-accent-3)" stroke-opacity="0.35" />
            {
              commitDots.map((dot) => (
                <circle
                  cx={dot.x.toFixed(1)}
                  cy={dot.y.toFixed(1)}
                  r={dot.r.toFixed(1)}
                  fill={dot.level > 0.7 ? 'var(--color-accent)' : dot.level > 0.35 ? 'var(--color-accent-2)' : 'var(--color-accent-3)'}
                  fill-opacity={(0.45 + dot.level * 0.55).toFixed(2)}
                />
              ))
            }
            {weeks.map((week, index) => <text x={46 + index * 78} y="146" text-anchor="middle" fill="var(--color-muted)" font-size="8">{week}</text>)}
          </svg>
        </div>

        <!-- Front panel: features -->
        <figure class="card relative p-4 shadow-[0_30px_80px_-20px_rgb(0_0_0/0.9)] sm:mr-20 sm:p-5">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm font-semibold">
              <span class="icon-tile inline-flex size-6 items-center justify-center rounded-md text-accent">
                <LayoutDashboard size={13} aria-hidden="true" />
              </span>
              src/features
            </div>
            <span class="rounded-full border border-line bg-surface-2 px-2.5 py-0.5 font-mono text-[0.7rem] text-muted">4 features</span>
          </div>
          <ul class="mt-4 divide-y divide-line/70 overflow-hidden rounded-xl border border-line bg-ink/60">
            {
              dashboardFeatures.map((feature, index) => (
                <li class:list={['p-3', index === 0 && 'bg-gradient-to-r from-accent/[0.07] to-transparent']}>
                  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                    <svg viewBox="0 0 16 16" class="size-3.5 -rotate-90" aria-hidden="true">
                      <circle cx="8" cy="8" r="6" fill="none" stroke="var(--color-line)" stroke-width="2" />
                      <circle cx="8" cy="8" r="6" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-dasharray={ring(feature.coverage)} />
                    </svg>
                    <span class="font-mono text-sm font-semibold text-accent">{feature.name}</span>
                    <span class="inline-flex items-center gap-1 rounded-full border border-line bg-surface-2 py-px pr-2 pl-px text-[0.65rem] leading-4 text-muted">
                      <span class="bg-gradient-brand inline-flex size-3.5 items-center justify-center rounded-full text-[0.45rem] font-bold text-ink">
                        {feature.owner.replace('team-', '').slice(0, 2).toUpperCase()}
                      </span>
                      {feature.owner}
                    </span>
                    <span class="ml-auto text-[0.7rem] text-muted">
                      {feature.todos} TODO{feature.todos === 1 ? '' : 's'}
                    </span>
                  </div>
                  <div class="mt-2.5 grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-1.5 text-[0.65rem] text-muted">
                    <span>coverage</span>
                    <span class="h-1 overflow-hidden rounded-full bg-surface-2">
                      <span class="block h-full rounded-full bg-gradient-to-r from-accent-3/40 to-accent" style={`width:${feature.coverage}%`} />
                    </span>
                    <span class="font-mono text-text">{feature.coverage}%</span>
                    <span>commits</span>
                    <span class="flex h-1 gap-px overflow-hidden rounded-full">
                      <span class="rounded-full bg-accent" style={`width:${feature.mix[0]}%`} />
                      <span class="rounded-full bg-accent-2/70" style={`width:${feature.mix[1]}%`} />
                      <span class="rounded-full bg-accent-3/50" style={`width:${feature.mix[2]}%`} />
                    </span>
                    <span class="font-mono text-text">{feature.mix[0]}%</span>
                  </div>
                </li>
              ))
            }
          </ul>
          <figcaption class="mt-3.5 flex flex-wrap gap-4 text-[0.7rem] text-muted">
            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>feature</span>
            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-accent-2/70" aria-hidden="true"></span>fix</span>
            <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-accent-3/50" aria-hidden="true"></span>refactor</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- AI era -->
  <Section
    id="ai-era"
    eyebrow="Built for the age of AI"
    title="Features ship in minutes. Keep track of all of them."
    lead="With Claude Code, Cursor or Copilot, a new feature takes minutes, not weeks. Writing code is no longer the bottleneck. Tracking, documenting and maintaining what you built is."
  >
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        aiEraReasons.map(({ icon: Icon, title, text }) => (
          <li class="card p-5">
            <span class="icon-tile inline-flex size-10 items-center justify-center rounded-lg text-accent-2">
              <Icon size={20} aria-hidden="true" />
            </span>
            <h3 class="mt-4 font-semibold">{title}</h3>
            <p class="mt-1.5 text-sm text-muted">{text}</p>
          </li>
        ))
      }
    </ul>
    <div class="card relative mt-6 overflow-hidden p-6 sm:p-8">
      <div class="spotlight pointer-events-none absolute -top-24 -left-24 h-72 w-[36rem]" aria-hidden="true"></div>
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div class="relative grid items-center gap-6 md:grid-cols-[1fr_auto]">
        <p class="text-lg text-pretty">
          You need <strong class="text-gradient font-semibold">one place to overview all your features</strong>: what
          exists, who owns it, how healthy it is and what changed recently. Features builds that place from your code,
          so it stays current however fast you ship.
        </p>
        <a href="#how-it-works" class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-2.5 font-semibold whitespace-nowrap transition hover:border-muted">
          See how it works <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </Section>

  <!-- How it works -->
  <Section
    id="how-it-works"
    eyebrow="How it works"
    title="From folders to insights in three steps"
    lead="Features reads the structure you already have. Group code by feature, run the CLI, and every report is generated for you."
  >
    <ol class="grid gap-5 md:grid-cols-3">
      <li class="card relative p-6">
        <span class="text-fade font-mono text-5xl font-bold" aria-hidden="true">01</span>
        <h3 class="mt-2 text-lg font-semibold">Organize by feature</h3>
        <p class="mt-2 text-sm text-muted">
          Put each business feature in its own folder inside a <code>features</code> folder, or flag any folder with
          <code>feature: true</code> in its README.
        </p>
        <pre class="mt-5 rounded-lg bg-ink/60 p-3 font-mono text-xs leading-6 text-muted"><span class="text-accent-2">features/</span>
├── <span class="text-accent">auth/</span>
├── <span class="text-accent">billing/</span>
└── <span class="text-accent">search/</span></pre>
      </li>
      <li class="card relative p-6">
        <span class="text-fade font-mono text-5xl font-bold" aria-hidden="true">02</span>
        <h3 class="mt-2 text-lg font-semibold">Run the CLI</h3>
        <p class="mt-2 text-sm text-muted">
          One binary, written in Rust. Install it with npm or cargo, or run it on the fly with <code>npx</code>.
        </p>
        <pre class="mt-5 rounded-lg bg-ink/60 p-3 font-mono text-xs leading-6 text-muted"><span class="select-none">$ </span><span class="text-text">features scan ./src</span>
<span class="select-none">$ </span><span class="text-text">features serve ./src</span>
<span class="select-none">$ </span><span class="text-text">features codeowners ./src</span></pre>
      </li>
      <li class="card relative p-6">
        <span class="text-fade font-mono text-5xl font-bold" aria-hidden="true">03</span>
        <h3 class="mt-2 text-lg font-semibold">Explore and share</h3>
        <p class="mt-2 text-sm text-muted">
          Browse the dashboard, publish a static build, export JSON or comment on pull requests.
        </p>
        <ul class="mt-5 grid grid-cols-2 gap-2 text-xs md:grid-cols-1 lg:grid-cols-2">
          <li class="flex items-center gap-2 rounded-lg bg-ink/60 p-2.5"><LayoutDashboard size={14} class="shrink-0 text-accent" aria-hidden="true" />Dashboard</li>
          <li class="flex items-center gap-2 rounded-lg bg-ink/60 p-2.5"><Braces size={14} class="shrink-0 text-accent-3" aria-hidden="true" />JSON report</li>
          <li class="flex items-center gap-2 rounded-lg bg-ink/60 p-2.5"><FileLock size={14} class="shrink-0 text-accent-2" aria-hidden="true" />CODEOWNERS</li>
          <li class="flex items-center gap-2 rounded-lg bg-ink/60 p-2.5"><GitPullRequest size={14} class="shrink-0 text-accent" aria-hidden="true" />PR comment</li>
        </ul>
      </li>
    </ol>
  </Section>

  <!-- Capabilities -->
  <Section
    id="capabilities"
    eyebrow="Capabilities"
    title="One tool, every question about your features"
    lead="Who owns this? How healthy is it? What did this pull request touch? Features answers from the code itself, so the answers never go stale."
  >
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        capabilities.map(({ icon: Icon, title, text }) => (
          <li class="card group p-5 transition hover:border-muted/60">
            <span class="icon-tile inline-flex size-10 items-center justify-center rounded-lg text-accent transition group-hover:text-accent-3">
              <Icon size={20} aria-hidden="true" />
            </span>
            <h3 class="mt-4 font-semibold">{title}</h3>
            <p class="mt-1.5 text-sm text-muted">{text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Screenshot -->
  <Section
    id="dashboard"
    eyebrow="Web dashboard"
    title="A dashboard your whole team can read"
    lead="Run features serve for a live dashboard refreshed on every file change, or features build to publish a static version anywhere."
  >
    <Screenshot
      name="insights"
      alt="Insights page of the Features dashboard: totals of features and owners, and a table of every feature with its owner, dates, files, lines, TODOs and changes"
      caption="Insights: every feature with its owner, size, TODOs and commit history, filterable with queries like owner:john AND lines:>1000."
      featured
    />
    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <Screenshot
        name="dependencies"
        alt="Dependency graph of the Features dashboard: features as nodes colored by owner, with parent, child and sibling links and circular dependencies in red"
        caption="Dependencies: a graph of the imports between features, colored by owner, with circular dependencies flagged."
      />
      <Screenshot
        name="ownership"
        alt="Ownership tab of the Features dashboard: a table of owners with their number of features, files, lines and annotations"
        caption="Ownership: what each team owns, in features, files, lines and annotated flags."
      />
    </div>
    <p class="mt-8">
      <a href={site.demo} class="inline-flex items-center gap-1 text-accent hover:underline">
        Explore the live demo <ArrowRight size={16} aria-hidden="true" />
      </a>
    </p>
  </Section>

  <!-- Pull request -->
  <Section
    id="pull-requests"
    eyebrow="Code review"
    title="Know which teams a change touches"
    lead="features diff maps every changed file to its closest feature and owner. Post it as a pull request comment, or request reviews from the owning teams automatically."
  >
    <div class="grid items-start gap-6 lg:grid-cols-2">
      <Terminal title="features diff src --since origin/master">
<span class="text-muted">Features touched since origin/master (merge base 1a2b3c4):</span>

  <span class="font-semibold text-accent">Auth</span> <span class="text-muted">(features/auth) - owner:</span> <span class="text-accent-3">team-auth</span>
    <span class="text-accent-3">M</span> src/features/auth/login.ts
    <span class="text-accent-2">R</span> src/features/auth/old.ts -> src/features/billing/moved.ts

  <span class="font-semibold text-accent">Billing</span> <span class="text-muted">(features/billing) - owner:</span> <span class="text-accent-3">team-billing</span>
    <span class="text-accent-2">R</span> src/features/auth/old.ts -> src/features/billing/moved.ts
    <span class="text-[#ff5f57]">D</span> src/features/billing/legacy.ts

<span class="text-muted">Files outside any feature:</span>
    <span class="text-accent-3">M</span> README.md</Terminal>
      <div class="card p-6">
        <div class="flex items-center gap-3">
          <span class="bg-gradient-brand inline-flex size-9 items-center justify-center rounded-full text-ink"><GitPullRequest size={18} aria-hidden="true" /></span>
          <div>
            <p class="text-sm font-semibold">github-actions <span class="font-normal text-muted">commented</span></p>
            <p class="text-xs text-muted">on pull request</p>
          </div>
        </div>
        <p class="mt-5 text-sm font-semibold">Features touched by this pull request</p>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="text-xs text-muted">
              <tr class="border-b border-line"><th class="py-2 pr-4 font-medium">Feature</th><th class="py-2 pr-4 font-medium">Owner</th><th class="py-2 font-medium">Files</th></tr>
            </thead>
            <tbody>
              <tr class="border-b border-line/60"><td class="py-2 pr-4 font-mono text-accent">auth</td><td class="py-2 pr-4">@team-auth</td><td class="py-2">2</td></tr>
              <tr><td class="py-2 pr-4 font-mono text-accent">billing</td><td class="py-2 pr-4">@team-billing</td><td class="py-2">2</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-5 flex flex-wrap items-center gap-2 text-xs text-muted">
          Reviewers requested:
          <span class="rounded-full border border-line px-2 py-0.5 text-text">my-org/team-auth</span>
          <span class="rounded-full border border-line px-2 py-0.5 text-text">my-org/team-billing</span>
        </p>
        <a href="/cli#pull-requests" class="link mt-6 inline-block text-sm">Set it up with GitHub Actions</a>
      </div>
    </div>
  </Section>

  <!-- Languages -->
  <Section
    id="languages"
    eyebrow="Technology agnostic"
    title="Works with the stack you already have"
    lead="Features only reads folders, READMEs, git history and comments. Feature annotations are recognized in all these languages."
  >
    <ul class="flex flex-wrap gap-2">
      {
        languages.map((language) => (
          <li class="rounded-full border border-line bg-surface/70 px-3.5 py-1.5 font-mono text-sm text-muted">{language}</li>
        ))
      }
    </ul>
  </Section>

  <CallToAction />
</Base>
