---
// Screenshots of the dashboard demo, generated by scripts/capture-screenshots.mjs.
const heights = {
  insights: 800,
  ownership: 560,
  dependencies: 800,
  feature: 560,
  decisions: 480,
  flags: 480,
  'nested-features': 560,
} as const

interface Props {
  name: keyof typeof heights
  alt: string
  caption?: string
  /** Load immediately instead of lazily (for images above the fold). */
  eager?: boolean
  /** Hero treatment: tilted back until it scrolls into view, with a light behind it. */
  featured?: boolean
  class?: string
}

const {
  name,
  alt,
  caption,
  eager = false,
  featured = false,
  class: className = '',
} = Astro.props
const src = `/screenshots/${name}.webp`
---

<figure class:list={['relative', className]}>
  {
    featured && (
      <div class="spotlight pointer-events-none absolute inset-x-[10%] -top-16 h-56" aria-hidden="true" />
    )
  }
  <div class:list={['card overflow-hidden p-1.5 shadow-2xl shadow-black/60', { tilt: featured }]}>
    <a
      href={`/screenshots/${name}@2x.webp`}
      class="block overflow-hidden rounded-[0.6rem] border border-line/70"
      title="Open the full-size screenshot"
    >
      <img
        src={src}
        srcset={`${src} 1280w, /screenshots/${name}@2x.webp 2560w`}
        sizes="(min-width: 1152px) 1104px, 100vw"
        alt={alt}
        width="1280"
        height={heights[name]}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="block h-auto w-full"
      />
    </a>
  </div>
  {caption && <figcaption class="mt-3 px-1 text-sm text-muted">{caption}</figcaption>}
</figure>
