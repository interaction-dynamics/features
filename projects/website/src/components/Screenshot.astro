---
// Screenshots of the dashboard demo, generated by scripts/capture-screenshots.mjs.
const heights = {
  insights: 800,
  ownership: 560,
  dependencies: 800,
  feature: 560,
  'specs-decisions': 960,
  flags: 480,
  'nested-features': 560,
} as const

interface Props {
  name: keyof typeof heights
  alt: string
  caption?: string
  /** Load immediately instead of lazily (for images above the fold). */
  eager?: boolean
  class?: string
}

const { name, alt, caption, eager = false, class: className = '' } = Astro.props
const src = `/screenshots/${name}.webp`
---

<figure class:list={['card overflow-hidden', className]}>
  <div class="flex items-center gap-1.5 border-b border-line bg-surface-2 px-3 py-2" aria-hidden="true">
    <span class="size-2.5 rounded-full bg-line"></span>
    <span class="size-2.5 rounded-full bg-line"></span>
    <span class="size-2.5 rounded-full bg-line"></span>
  </div>
  <a href={`/screenshots/${name}@2x.webp`} class="block" title="Open the full-size screenshot">
    <img
      src={src}
      srcset={`${src} 1280w, /screenshots/${name}@2x.webp 2560w`}
      sizes="(min-width: 1152px) 1104px, 100vw"
      alt={alt}
      width="1280"
      height={heights[name]}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="block h-auto w-full"
    />
  </a>
  {caption && <figcaption class="border-t border-line px-4 py-3 text-sm text-muted">{caption}</figcaption>}
</figure>
