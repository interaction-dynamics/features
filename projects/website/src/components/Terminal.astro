---
interface Props {
  title?: string
  class?: string
}

const { title = 'terminal', class: className = '' } = Astro.props
---

<figure class:list={['card overflow-hidden shadow-2xl shadow-black/40', className]}>
  <div class="flex items-center gap-2 border-b border-line bg-surface-2 px-4 py-2.5">
    <span class="size-3 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
    <span class="size-3 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
    <span class="size-3 rounded-full bg-[#28c840]" aria-hidden="true"></span>
    <figcaption class="ml-2 font-mono text-xs text-muted">{title}</figcaption>
  </div>
  <pre class="overflow-x-auto bg-ink/60 p-5 font-mono text-[0.8rem] leading-relaxed sm:text-sm"><slot /></pre>
</figure>
