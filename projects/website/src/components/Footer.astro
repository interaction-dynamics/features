---
import { githubUrl, nav, site } from '../data/site'
---

<footer class="mt-24 border-t border-line/70">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 text-sm sm:px-6 md:grid-cols-4">
    <div class="md:col-span-2">
      <a href="/" class="flex items-center gap-2 font-semibold">
        <img src="/favicon.svg" alt="" width="24" height="24" loading="lazy" />
        Features
      </a>
      <p class="mt-3 max-w-sm text-muted">
        Open-source CLI and web dashboard to explore the features of any codebase.
        Released under the {site.license} license.
      </p>
    </div>
    <div>
      <p class="font-medium">Learn</p>
      <ul class="mt-3 space-y-2 text-muted">
        {nav.map((item) => (
          <li><a class="hover:text-text" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-medium">Project</p>
      <ul class="mt-3 space-y-2 text-muted">
        <li><a class="hover:text-text" href={site.demo}>Live demo</a></li>
        <li><a class="hover:text-text" href={site.repository} rel="noopener">GitHub</a></li>
        <li><a class="hover:text-text" href={site.npm} rel="noopener">npm</a></li>
        <li><a class="hover:text-text" href={site.crate} rel="noopener">crates.io</a></li>
        <li><a class="hover:text-text" href={site.roadmap} rel="noopener">Roadmap</a></li>
        <li><a class="hover:text-text" href={githubUrl('CONTRIBUTING.md')} rel="noopener">Contributing</a></li>
        <li><a class="hover:text-text" href="/llms.txt">llms.txt</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line/70 py-6 text-center text-xs text-muted">
    © {new Date().getFullYear()} <a class="hover:text-text" href={site.organizationUrl}>{site.organization}</a>
  </div>
</footer>
