{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", ".astro", ".vercel"],
  "overrides": [
    {
      "files": ["**/*.astro"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
